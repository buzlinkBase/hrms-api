{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AdmsConnection": "",
    "Redis": "127.0.0.1:6379,abortConnect=false"
  },
  "ApiServices": {
    "AuthService": "http://auth-api:8080",
    "TenantService": "http://tenant-api:8080"
  },
  "Serilog": {
    "Using": [ "Serilog.Exceptions", "Serilog.Sinks.Grafana.Loki" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": {
      "Console": { "Name": "Console" },
      "Loki": {
        "Name": "GrafanaLoki",
        "Args": {
          "queueLimit": 10000,
          "batchPostingLimit": 1000,
          "uri": "http://loki:3100",
          "labels": [
            { "key": "app", "value": "adms-api" },
            { "key": "system", "value": "adms" }
          ]
        }
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithEnvironmentName",
      "WithProcessId",
      "WithProcessName",
      "WithExceptionDetails"
    ],
    "Properties": {
      "Project": "adms-api",
      "System": "adms"
    }
  }
}
