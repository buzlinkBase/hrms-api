{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MassTransit": "Debug"
    }
  },
  "ConnectionStrings": {
    "TenantStoreConnection": "server=165.232.166.164;port=3306;database=tenantstore;user=oneuser;pwd=Pokemon67584321",
    "Redis": "127.0.0.1:6379,abortConnect=false"
  },
  "SYSTEM_NAME": "HRIS",
  "RabbitMqSettings": {
    "Uri": "amqp://guest:guest@localhost:5672"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Using": [ "Serilog.Exceptions", "Serilog.Sinks.Grafana.Loki" ],
    "WriteTo": {
      "Console": { "Name": "Console" },
      "Loki": {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://loki:3100",
          "labels": [
            { "key": "app", "value": "hrms-migration" },
            { "key": "system", "value": "hrms-migrations-console" }
          ]
        }
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithEnvironmentName",
      "WithProcessId",
      "WithProcessName",
      "WithExceptionDetails"
    ],
    "Properties": {
      "Project": "MigrationHrms",
      "System": "hrms-migrations-console"
    }
  }
}
